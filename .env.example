# ============================================================
# 开放空间安全平台 —— 全项目唯一配置模板
#
# 使用：
#   cp .env.example .env 后按需填写；.env 已被 .gitignore 忽略，永不入库。
#
# 规则：
#   1. 本文件只保留键名与说明，所有值保持为空（开源仓库不得含任何真实地址 / 凭据）。
#   2. 加载优先级：系统环境变量 > 根 .env > 代码默认值。
#   3. 后端（server/config/index.js）、前端 dev 代理（vite.config.ts）、
#      部署脚本（deploy-docker.sh）均从本文件读取 —— 迁移 / 换机只改 .env 一处。
#   4. Docker 部署：deploy-docker.sh 以 --env-file 在运行时注入容器，凭据不进镜像。
# ============================================================

# ---------- 站点 / 端口 ----------
# 服务器对外 IP 或域名（nginx server_name、vite dev 代理共用）
SERVER_HOST=
# 前端 / 后端对外端口（部署脚本使用；容器内固定 1233/1234 不受影响）
FRONT_PORT=
BACK_PORT=
# 前端构建期变量：部署在根路径留空即可；子路径部署示例 VITE_BASE=/zxsd/ VITE_API_BASE=/zxsd/server
VITE_BASE=
VITE_API_BASE=

# ---------- 后端 ----------
# 后端监听端口（容器内固定 1234，本地开发可自定义）
PORT=
# development / production
NODE_ENV=

# ---------- 数据库（必填） ----------
# 指向一个空库即可：首次启动自动建表（server/db/schema.sql，幂等）并初始化
# 内置账号 admin（初始密码 admin123456，见启动日志，请登录后立即修改）
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
# 连接池大小（连远程云库建议调小，如 3）
DB_POOL_LIMIT=
# 是否打印 SQL 日志（开发调试用）
DB_DEBUG=

# ---------- 安全 ----------
# 生产环境必填（随机长字符串，缺失时后端启动直接报错）
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
# 密码哈希加盐轮数（bcrypt，默认 10）
BCRYPT_SALT_ROUNDS=

# ---------- 跨域 ----------
# '*' 允许任意来源；或逗号分隔白名单
CORS_ORIGIN=
# 是否允许跨域携带 Cookie
CORS_CREDENTIALS=

# ---------- Space-Track 卫星数据源（https://www.space-track.org 注册） ----------
SAT_USERNAME=
SAT_PASSWORD=
SAT_BASE_URL=
SAT_LIMIT=
SAT_CONJ_THRESHOLD=
SAT_CONJ_COARSE=
SAT_CONJ_LOOK_HOURS=
SAT_CDM_CLASS=
SAT_CDM_LIMIT=

# ---------- AOE 轨道库（spacemapper.cn 控制台创建 API 令牌） ----------
AOE_API_TOKEN=
AOE_BASE_URL=

# ---------- 大模型（OpenAI 兼容云端 API，空间态势智能体） ----------
AI_PROVIDER=
AI_API_BASE=
AI_API_KEY=
AI_CLOUD_MODEL=
AI_API_TIMEOUT_MS=
AI_MAX_ROUNDS=
AI_MAX_TOKENS=
AI_TEMPERATURE=
AI_HISTORY_MAX=
AI_CGI_PER_MINUTE=
AI_CGI_MAX_INFLIGHT=
AI_CGI_MAX_CHARS=

# ---------- 算法调度（可留空，走代码默认值） ----------
# CPU 亲和性绑核（仅 Linux/Docker 生效），如 1-7 表示 worker 用 1~7 号核
SCAN_ALGO_CPUS=
SCAN_TOTAL_CORES=
SCAN_MIN_CORES=
SCAN_MAX_CONCURRENT=
CONJ_SCAN_WORKERS=
CONJ_SCAN_HEAP_MB=
CRI_SCAN_WORKERS=
CRI_SCAN_HEAP_MB=
PASS_SCAN_WORKERS=
PASS_SCAN_HEAP_MB=
SCHEDULE_TZ=

# ---------- 精度自证工具（server/tools/pc-verify，可选） ----------
PC_VERIFY_BASE=
PC_VERIFY_USER=
PC_VERIFY_PASS=
