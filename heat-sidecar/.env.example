# ============================================================
# heat-sidecar 配置模板
# 复制为 heat-sidecar/.env 后填写真实凭据（.env 已在 .gitignore 中，禁止入库）
# ============================================================

# ---------- 服务 ----------
PORT=1235
# 手动触发同步/筛查接口的令牌（POST /cgi2/admin/*，请求头 X-Admin-Token）
SIDECAR_ADMIN_TOKEN=
LOG_LEVEL=info

# ---------- 数据库（与 server.jsc 同一个库） ----------
# 本地开发：MySQL 容器映射到宿主机 13306
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=openspace
DB_PASSWORD=
DB_NAME=openspace

# ---------- 同步间隔（小时） ----------
SYNC_INTERVAL_HOURS=48
# 可单独覆盖（留空/不写则沿用 SYNC_INTERVAL_HOURS）
SYNC_GP_HOURS=
SYNC_CDM_HOURS=
SYNC_EPH_HOURS=
SYNC_AOE_HOURS=
SYNC_SUPGP_HOURS=

# ---------- Space-Track（GP / CDM 同步需要登录） ----------
SAT_USERNAME=
SAT_PASSWORD=
SAT_BASE_URL=https://www.space-track.org

# ---------- AOE（spacemapper） ----------
# 缺失时 aoe 同步直接跳过，并在 /cgi2/sync/status 标记为 skipped
AOE_API_TOKEN=
AOE_BASE_URL=https://spacemapper.cn

# ---------- Starlink 公开星历 ----------
STARLINK_EPH_BASE=https://api.starlink.com/public-files/ephemerides/
# 每轮最多处理的星历文件数（默认 50，0 = 不限），点数据以 HSEPH1 gzip BLOB 存入 MySQL hs_ephem
STARLINK_EPH_MAX_FILES=50
STARLINK_EPH_CONCURRENCY=8

# ---------- 筛查参数（P2 使用） ----------
HBR_M=10
MISS_MAX_KM=10
SCREEN_WINDOW_H=72
SCREEN_ON_SYNC=true
SCREEN_TIMEOUT_MIN=60

# ---------- 已上传星历（03 §15） ----------
# 存放目录：必须在 web 根目录与 jsc /uploads 之外
HEAT_UPLOAD_DIR=./data/uploads
# 保留天数
HEAT_UPLOAD_TTL_D=7
# 全局每小时上传上限 / 按需任务排队上限 / 按需任务 worker 数
HEAT_UPLOAD_PER_HOUR=20
HEAT_SCREEN_QUEUE_MAX=5
HEAT_UPLOAD_WORKERS=2

# ---------- 私有核心（03 §7） ----------
# 不配置 = 使用随服务部署的内置引擎；配置后从该路径加载（.js/.cjs 或 bytenode 加载器）
HEAT_CORE_PATH=
# 1 = 核心加载失败时直接退出
HEAT_CORE_REQUIRED=0
