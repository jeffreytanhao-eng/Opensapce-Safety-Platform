{
  "name": "heat-sidecar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "description": "安全热力独立计算服务：数据同步 + 星历筛查 + /cgi2 接口（不依赖 server.jsc）",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "selftest": "node scripts/selftest.mjs"
  },
  "dependencies": {
    "@types/multer": "^1.4.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "satellite.js": "^7.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "~5.6.3"
  }
}
